{
  "name": "web-control-server",
  "version": "1.0.0",
  "description": "Web-based file management and system control server",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "pkg . --targets node24-win-x64 --output dist/TorSt.exe --compress GZip",
    "build:fast": "pkg . --targets node24-win-x64 --output dist/TorSt.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "node_modules/strtok3/**/*",
      "node_modules/token-types/**/*",
      "node_modules/@tokenizer/**/*",
      "node_modules/music-metadata/**/*",
      "node_modules/peek-readable/**/*",
      "node_modules/file-type/**/*",
      "node_modules/uint8array-extras/**/*",
      "node_modules/@borewit/**/*",
      "node_modules/win-guid/**/*",
      "node_modules/content-type/**/*",
      "node_modules/media-typer/**/*",
      "node_modules/debug/**/*",
      "node_modules/ms/**/*"
    ],
    "scripts": [
      "node_modules/**/*.js"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "date-fns": "^2.30.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "fs-extra": "^11.2.0",
    "helmet": "^7.1.0",
    "is-path-inside": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.6.0",
    "mime-types": "^2.1.35",
    "multer": "^2.0.0-rc.4",
    "music-metadata": "^11.12.3",
    "systeminformation": "^5.21.11",
    "uuid": "^14.0.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.23.0",
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "file-manager",
    "cloud-storage",
    "system-control",
    "web-server"
  ],
  "author": "Administrator",
  "license": "MIT"
}
